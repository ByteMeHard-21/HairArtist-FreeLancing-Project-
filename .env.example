# Server-only. Copy to .env.local; never commit real credentials.
SUPABASE_URL=https://qrwlkfuwvnqbwhucdxpo.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a cryptographically random secret of at least 32 characters.
BOOKING_HMAC_SECRET=
# Admin access is managed in public.admin_users after email/password sign-in.
# Optional: only a header that your hosting proxy overwrites, never an untrusted forwarded header.
TRUSTED_CLIENT_IP_HEADER=
# HTTPS gateway contract documented in BOOKING-IMPLEMENTATION-REPORT.md
VERIFICATION_BASE_URL=
VERIFICATION_TOKEN=
WHATSAPP_NOTIFICATION_URL=
WHATSAPP_NOTIFICATION_TOKEN=

# Canonical public origin on the deployed host, e.g. https://your-real-domain
APP_ORIGIN=
